{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sniffer",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-05",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sniffer",
      // Replace after: npx wrangler d1 create sniffer
      "database_id": "16777587-6751-4a31-9257-5fdb73417e21",
      "migrations_dir": "migrations"
    }
  ]
  // Secret: npx wrangler secret put INGEST_TOKEN
}
